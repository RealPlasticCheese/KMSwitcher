{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "KMSwitcher: Build controller (ESP32-S3)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/idf.ps1", "-Project", "controller", "-Action", "build"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "KMSwitcher: Build receiver (ESP32-S2)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/idf.ps1", "-Project", "receiver", "-Action", "build"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "KMSwitcher: List USB devices",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/list-devices.ps1"],
      "problemMatcher": []
    }
  ]
}
