CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# Decode USB input and service radio acknowledgements without a debug-build backlog.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../config/partitions.controller.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# N16R8 controller: explicit PSRAM allocations keep normal malloc internal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y
CONFIG_LOG_COLORS=n
