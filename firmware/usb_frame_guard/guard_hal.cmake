# Replace exactly the reviewed HAL translation unit in the build, never the SDK.
function(kms_usb_frame_guard_apply)
    if(NOT IDF_TARGET STREQUAL "esp32s3")
        message(FATAL_ERROR "Review the USB frame guard before using another target")
    endif()
    set(guard_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    idf_component_get_property(hal_dir esp_hal_usb COMPONENT_DIR)
    idf_component_get_property(hal_lib esp_hal_usb COMPONENT_LIB)
    set(overlay "${CMAKE_CURRENT_BINARY_DIR}/usb_dwc_hal_guarded.c")
    execute_process(COMMAND "${PYTHON}" "${guard_dir}/instrument_hal.py"
        "${hal_dir}/usb_dwc_hal.c" "${overlay}" COMMAND_ERROR_IS_FATAL ANY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${hal_dir}/usb_dwc_hal.c" "${guard_dir}/instrument_hal.py")
    get_target_property(sources ${hal_lib} SOURCES)
    list(LENGTH sources before)
    list(FILTER sources EXCLUDE REGEX "(^|/)usb_dwc_hal\\.c$")
    list(LENGTH sources after)
    math(EXPR removed "${before}-${after}")
    if(NOT removed EQUAL 1)
        message(FATAL_ERROR "Expected exactly one upstream USB HAL translation unit")
    endif()
    set_property(TARGET ${hal_lib} PROPERTY SOURCES "${sources}")
    target_sources(${hal_lib} PRIVATE "${overlay}" "${guard_dir}/kms_usb_frame_guard.c")
    target_include_directories(${hal_lib} PRIVATE "${guard_dir}")
    target_link_libraries(${hal_lib} PRIVATE idf::esp_timer idf::freertos idf::soc)
endfunction()
