FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive QT_QPA_PLATFORM=offscreen
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev python3-tk build-essential libffi-dev libssl-dev \
    binutils rpm dpkg-dev git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/kms-build
COPY scripts/package-linux.py scripts/install-build-dependencies.py scripts/
COPY packaging/requirements-linux.lock packaging/
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends $(python3 scripts/package-linux.py --print-build-dependencies) \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/kms-build-venv
ENV PATH=/opt/kms-build-venv/bin:$PATH
RUN --mount=type=cache,target=/root/.cache/pip python scripts/install-build-dependencies.py
WORKDIR /src
