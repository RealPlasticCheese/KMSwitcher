{
  "name": "kmswitcher-console",
  "author": "Frank Tzanabetis",
  "homepage": "https://plasticcheese.com",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "test": "node --test tests/*.test.js",
    "start": "node serve.js",
    "build:controller": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File build-firmware.ps1 -Target controller",
    "build:receiver": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File build-firmware.ps1 -Target receiver",
    "build:all": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File build-firmware.ps1 -Target all"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "fflate": "0.8.2"
  }
}
